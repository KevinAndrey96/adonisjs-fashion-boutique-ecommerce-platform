HOST=127.0.0.1
PORT=3333
NODE_ENV=development
APP_NAME="Fashion Boutique E-Commerce"
APP_URL=http://${HOST}:${PORT}

CACHE_VIEWS=false

# 32-character application encryption key
APP_KEY=

# Database Configuration (sqlite for zero-config local development, mysql for production/docker)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=development

# Session & Security
SESSION_DRIVER=cookie
HASH_DRIVER=bcrypt

# Mailer Configuration (Defaults to Mailpit in Docker)
MAIL_CONNECTION=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Optional PayU Web Gateway Integration (Sandbox)
ENABLE_PAYU=false
PAYU_TEST_MODE=1
PAYU_API_KEY=SANDBOX_PAYU_KEY
PAYU_MERCHANT_ID=SANDBOX_MERCHANT
PAYU_ACCOUNT_ID=SANDBOX_ACCOUNT
PAYU_URL=https://sandbox.checkout.payulatam.com/ppp-web-gateway-payu/
